# ==============================================================================
# KTD-Store Docker Environment Variables Configuration
# Copy this file to .env.docker or pass values directly into docker-compose.yml
# ==============================================================================

# Application Ports & Environment
NODE_ENV=production
PORT=3000

# PostgreSQL Database (Local Container)
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgrespassword
DB_NAME=menwear_db
DB_SSL=false

# Caching & Queue (Local Container)
REDIS_HOST=redis
REDIS_PORT=6379

# JWT Authentication
JWT_SECRET=ktd-store-super-secret-jwt-key-production-32chars
JWT_EXPIRATION=8h
JWT_REFRESH_SECRET=ktd-store-super-secret-refresh-jwt-key-32chars
JWT_REFRESH_EXPIRATION=7d

# CORS Allowed Frontend URLs
FRONTEND_URL=http://localhost,http://localhost:80,http://localhost:5173

# PayOS Payment Gateway (Optional - for real banking VietQR)
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key

# Email Provider (Optional - resend / smtp)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM="KTD Store <onboarding@resend.dev>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
MAIL_FROM="KTD Store <your_email@gmail.com>"

# Sentry Monitoring (Optional)
SENTRY_DSN=
