{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ktd-store-backend.onrender.com/:path*"
    },
    {
      "source": "/webhooks/:path*",
      "destination": "https://ktd-store-backend.onrender.com/webhooks/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
