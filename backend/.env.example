# Server
PORT=3000
NODE_ENV=development

# PostgreSQL Database (Neon / standard PG)
DB_HOST=your-db-host.neon.tech
DB_PORT=5432
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password
DB_NAME=your-db-name
DB_SSL=true

# Redis (Caching & Bull Queue)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRATION=8h
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key-min-32-chars
JWT_REFRESH_EXPIRATION=7d

# Sentry Error Tracking (Optional)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# PayOS Integration
PAYOS_CLIENT_ID=your-client-id
PAYOS_API_KEY=your-api-key
PAYOS_CHECKSUM_KEY=your-checksum-key

# Email (Gmail SMTP / Custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_16_digit_app_password
MAIL_FROM="KTD Store <your_email@gmail.com>"
FRONTEND_URL=http://localhost:5173
